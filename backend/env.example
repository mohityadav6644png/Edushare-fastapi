# StudyShare Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/studyshare

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# CORS Configuration
CLIENT_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Production Configuration (uncomment for production)
# NODE_ENV=production
# CLIENT_URL=https://your-frontend-domain.com
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/studyshare?retryWrites=true&w=majority

# Optional: Logging Configuration
LOG_LEVEL=info

# Optional: Rate Limiting (if implemented)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
